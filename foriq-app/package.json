{
  "name": "foriq-app",
  "version": "0.2.0",
  "private": true,
  "description": "Foriq desktop app for macOS: supervises PostgreSQL, the backend (which also serves the web UI) and mDNS",
  "license": "AGPL-3.0-only",
  "main": "src/main.js",
  "scripts": {
    "start": "electron .",
    "start:test": "FORIQ_USER_DATA=\"$HOME/Library/Application Support/Foriq-Test\" FORIQ_NO_MDNS=1 FORIQ_PORT=8421 FORIQ_PG_PORT=54330 electron .",
    "setup:python": "sh scripts/setup-python.sh",
    "build:frontend": "sh scripts/build-frontend.sh",
    "build:backend": "sh scripts/build-backend.sh",
    "build:firmware": "sh scripts/build-firmware.sh",
    "icons": "${FORIQ_PYTHON:-python3} scripts/make_icons.py",
    "pack": "electron-builder --mac",
    "dist": "npm run build:frontend && npm run build:backend && npm run build:firmware && electron-builder --mac",
    "sim": "${FORIQ_PYTHON:-python3} scripts/sensor_sim.py",
    "test": "node --test test/*.test.js",
    "release:local": "sh scripts/release-local.sh",
    "release:github": "sh scripts/release-github.sh"
  },
  "dependencies": {
    "pg": "8.23.1"
  },
  "optionalDependencies": {
    "@embedded-postgres/darwin-arm64": "18.6.0-beta.19"
  },
  "devDependencies": {
    "electron": "45.3.4",
    "electron-builder": "26.18.0"
  },
  "build": {
    "appId": "de.foriq.app",
    "productName": "Foriq",
    "copyright": "Ernst Schäfer Nachf. GmbH",
    "asar": false,
    "electronDist": "node_modules/electron/dist",
    "directories": {
      "output": "dist",
      "buildResources": "assets"
    },
    "files": [
      "src/**/*",
      "assets/trayTemplate*.png"
    ],
    "extraResources": [
      {
        "from": "../webapp/sql/schema.sql",
        "to": "foriq/sql/schema.sql"
      },
      {
        "from": "scripts/install.sh",
        "to": "foriq/install.sh"
      },
      {
        "from": "..",
        "to": "foriq/legal",
        "filter": [
          "LICENSE",
          "NOTICE",
          "THIRD_PARTY_NOTICES.md"
        ]
      }
    ],
    "afterPack": "scripts/after-pack.js",
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64"
          ]
        }
      ],
      "icon": "assets/icon.icns",
      "category": "public.app-category.utilities",
      "identity": "-",
      "hardenedRuntime": false,
      "notarize": false
    },
    "dmg": {
      "title": "Foriq ${version}"
    }
  },
  "author": "Ernst Schäfer Nachf. GmbH"
}
