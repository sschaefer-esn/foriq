# Development only: read by the backend (uvicorn from webapp/backend).
# The frontend (npm run dev in webapp/frontend/) needs no variables; it forwards
# /api/* to http://localhost:8005 (different target: FORIQ_DEV_BACKEND).
# The Foriq app sets all values itself and does not need this file.
# Local copy: cp .env.example .env  (.env is gitignored)

# ─── Database ───────────────────────────────────────────────
# REQUIRED: PostgreSQL connection URL; the backend aborts at startup if empty.
DATABASE_URL=postgresql://foriq:CHANGE-ME@localhost:5432/foriq

# Optional: SQLAlchemy connection pool (defaults 20 / 20 / 1800 seconds).
# DB_POOL_SIZE=20
# DB_MAX_OVERFLOW=20
# DB_POOL_RECYCLE=1800

# ─── Auth ────────────────────────────────────────────────────
# REQUIRED: signs login JWTs; the backend aborts if empty or the dev default.
# Generate with: openssl rand -hex 32
JWT_SECRET=your-jwt-secret-change-in-production

# Optional: HMAC key for device tokens (empty = plaintext tokens; else >= 32 chars).
# Never change it afterwards, or every sensor loses its registration.
DEVICE_TOKEN_HMAC_KEY=

# Key for hashing external ERP API keys; without it the external API is disabled.
API_KEY_HMAC_KEY=

# Optional: shared secret for the Foriq app endpoints /api/v1/devices/app*
# (USB sensor setup, owner password reset); empty = those endpoints are closed.
# FORIQ_APP_KEY=

# ─── Paths ───────────────────────────────────────────────────
# Optional: firmware directory for OTA (<dir>/.pio/build/<target>/firmware.bin or
# <dir>/release/<target>/); empty = firmware-cpp/ from the repo.
# FORIQ_FIRMWARE_DIR=

# Optional: static frontend export (webapp/frontend/out); if set, the backend serves the UI.
# FORIQ_FRONTEND_DIR=

# Optional: 1 = no background workers (OTA reaper, notifications, retention), for a
# development backend sharing the database of a running Foriq app (./dev.sh app).
# FORIQ_NO_WORKERS=

# ─── Logging ─────────────────────────────────────────────────
# Optional: Python log level (default INFO).
# LOG_LEVEL=INFO
